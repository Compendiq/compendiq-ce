# Dependencies
# No trailing slash: a directory-only pattern does not match a SYMLINK of the
# same name, which is how a `node_modules -> /Users/…` link was committed to a
# branch and reached the PR head (#1102 review r3).
node_modules
node_modules.old/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
.nvimlog

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Data (draw.io attachment cache)
backend/data/
data/

# Coverage
coverage/

# Playwright
test-results/
playwright-report/
e2e/.auth/
.playwright-mcp/

# Temp
tmp/
temp/

# Research
research/

# Java/binary artifacts
*.war
*.jar
*.ear

# Claude Code
.claude/
frontend/vendor/
firebase-debug.log

# Superpowers brainstorm — PID/runtime state files leak absolute paths and
# stale process IDs across machines. The prototype HTML files themselves
# were moved out of .superpowers/ to docs/design-exploration/ in #30.
.superpowers/brainstorm/**/state/

# k6 output files
perf/*.json
perf/*.html

# #1115: the VL embedding shim is a Python tool, so its virtualenv, bytecode
# and pytest cache land inside the checkout rather than in node_modules. The
# venv holds mlx/torch wheels measured in gigabytes.
tools/vl-embedding-shim/.venv
tools/**/__pycache__/
tools/**/.pytest_cache/
tools/**/*.egg-info/

# Impeccable — local UI critique runs and live-iteration scratch state
.impeccable/

# Local Confluence fixture that fakes the clock to keep an evaluation
# licence alive; not part of the shipped docker/ compose set.
docker/confluence-faketime.Dockerfile
docker/docker-compose.confluence.faketime.yml

# #1114: translator caches — resume state, not source.
backend/src/domains/llm/eval/corpus-*/.titles.json
backend/src/domains/llm/eval/corpus-*/.queries.json

# #1114: the two eval scripts' default report names. Both default relative to
# the cwd the runbook tells you to use (`cd backend`), so a bare run drops a
# measurement into the tree — a result, not source. CI writes the first of
# these by name (pr-check.yml). Pass --out for a report worth keeping.
backend/retrieval-eval.json
backend/query-latency.json
