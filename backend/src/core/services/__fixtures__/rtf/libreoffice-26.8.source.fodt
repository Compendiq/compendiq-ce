 <office:body>
  <office:text>
   <text:p>First paragraph of the Compendiq LibreOffice fixture.</text:p>
   <text:p>Second paragraph with a <text:a xlink:type="simple" xlink:href="https://example.com/compendiq-libreoffice">fixture link</text:a> inside.</text:p>
   <text:p>Third paragraph <text:bookmark-start text:name="lomark"/>ends<text:bookmark-end text:name="lomark"/> the LibreOffice fixture.<draw:frame draw:name="FixtureFrame" text:anchor-type="paragraph" svg:width="6cm" svg:height="2cm" svg:x="0cm" svg:y="0cm"><draw:text-box><text:p>Text box line of the LibreOffice fixture.</text:p></draw:text-box></draw:frame></text:p>
  </office:text>
